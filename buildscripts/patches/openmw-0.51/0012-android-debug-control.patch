+
+namespace MWInput
+{
+    namespace AndroidDebug
+    {
+        namespace
+        {
+            // Requests and servo targets arrive on binder threads (JNI) and
+            // are consumed on the engine thread; everything shared goes
+            // through these (mutex for strings, atomics for flags/numbers).
+            std::mutex sMutex;
+            std::string sHint;           // STATE target hint
+            std::string sFaceHint;       // SERVO face hint (one shot)
+            std::string sLoadPath;       // LOAD_SAVE path (one shot)
+            std::atomic<bool> sStatePending{ false };
+            std::atomic<bool> sLoadPending{ false };
+
+            std::mutex sActMutex;
+            std::string sActResult{ "none-yet" }; // last Player::activate outcome
+
+            std::atomic<int> sStreamPeriod{ 0 }; // frames between state lines
+            int sStreamCounter = 0;
+
+            enum class Servo
+            {
+                Off = 0,
+                Turn = 1,
+                Face = 2,
+                Walk = 3
+            };
+            std::atomic<int> sServoRequest{ 0 }; // Servo as int, consumed by tick
+            std::atomic<float> sServoDeg{ 0.f };
+            std::atomic<int> sServoMs{ 0 };
+            std::atomic<int> sServoCancelEpoch{ 0 };
+            int sCancelEpochSeen = 0;
+
+            // Live servo state (engine thread only).
+            Servo sMode = Servo::Off;
+            float sTargetYaw = 0.f;
+            bool sFaceResolved = false;
+            std::chrono::steady_clock::time_point sServoStart;
+            std::chrono::steady_clock::time_point sWalkLastCheck;
+            osg::Vec3f sWalkLastPos{ 0.f, 0.f, 0.f };
+            std::string sServoReport{ "off" }; // last finished servo outcome
+
+            // JOY_STATE: all six axes at once, held for a duration.
+            struct JoyHold
+            {
+                bool active = false;
+                bool pending = false;
+                float values[6] = { 0.f, 0.f, 0.f, 0.f, 0.f, 0.f };
+                std::chrono::steady_clock::time_point end;
+            } sHold;
+            std::mutex sHoldMutex; // guards the pending values written by JNI
+
+            constexpr float sCensusDoorRadius = 3000.f;
+            constexpr float sActorRadius = 4000.f;
+            constexpr int sMaxDoors = 8;
+            constexpr int sMaxActors = 6;
+            constexpr float sTurnDoneDeg = 1.5f; // accept within this yaw error
+            constexpr float sTurnGain = 0.08f;   // axis value per degree of error
+            constexpr float sTurnFloor = 0.35f;  // stay above the stick dead zone
+            constexpr float sServoTimeout = 30.f;
+
+            float normalizeDeg(float a)
+            {
+                while (a > 180.f)
+                    a -= 360.f;
+                while (a < -180.f)
+                    a += 360.f;
+                return a;
+            }
+
+            const MWWorld::Ptr playerPtr()
+            {
+                return MWBase::Environment::get().getWorld()->getPlayerPtr();
+            }
+
+            float playerYawDeg()
+            {
+                return playerPtr().getRefData().getPosition().rot[2] * 57.2957795f;
+            }
+
+            osg::Vec3f playerPos()
+            {
+                const float* p = playerPtr().getRefData().getPosition().pos;
+                return osg::Vec3f(p[0], p[1], p[2]);
+            }
+
+            float bearingTo(const float* target, const ESM::Position& pos)
+            {
+                return normalizeDeg(
+                    std::atan2(target[0] - pos.pos[0], target[1] - pos.pos[1]) * 57.2957795f
+                    - pos.rot[2] * 57.2957795f);
+            }
+
+            // SDL axis events reach ControllerManager through
+            // sdlinputwrapper, which rewrites every controller event to the
+            // generic device id 1 (one-joystick policy, matching
+            // BindingsManager::sFakeDeviceId where the axis binders live) —
+            // so synthetic events must use the same id or they land on a
+            // device with no bindings.
+            constexpr int sServoDeviceId = 1;
+
+            void injectAxis(ControllerManager& cm, int sdlAxis, float value)
+            {
+                SDL_ControllerAxisEvent ev{};
+                ev.which = sServoDeviceId;
+                ev.axis = static_cast<Uint8>(sdlAxis);
+                ev.value = static_cast<Sint16>(std::clamp(value, -1.f, 1.f) * 32767.f);
+                cm.axisMoved(sServoDeviceId, ev);
+            }
+
+            void finishServo(ControllerManager& cm, const std::string& outcome)
+            {
+                if (sMode == Servo::Turn || sMode == Servo::Face)
+                    injectAxis(cm, SDL_CONTROLLER_AXIS_RIGHTX, 0.f);
+                else if (sMode == Servo::Walk)
+                    injectAxis(cm, SDL_CONTROLLER_AXIS_LEFTY, 0.f);
+                sMode = Servo::Off;
+                sServoReport = outcome;
+                Log(Debug::Info) << "[Android DebugServo] " << outcome;
+            }
+
+            // Nearest actor whose name contains the hint; empty Ptr if none.
+            MWWorld::Ptr nearestHintActor(const std::string& hint, float& outDist, float& outBearing)
+            {
+                outDist = -1.f;
+                outBearing = 0.f;
+                if (hint.empty())
+                    return {};
+                const MWWorld::Ptr player = playerPtr();
+                const ESM::Position& pos = player.getRefData().getPosition();
+                std::vector<MWWorld::Ptr> actors;
+                MWBase::Environment::get().getMechanicsManager()->getActorsInRange(
+                    osg::Vec3f(pos.pos[0], pos.pos[1], pos.pos[2]), sActorRadius, actors);
+                const MWWorld::Ptr* best = nullptr;
+                float bestDist = 0.f;
+                const std::string needle = Misc::StringUtils::lowerCase(hint);
+                for (const MWWorld::Ptr& actor : actors)
+                {
+                    if (actor == player || actor.isEmpty())
+                        continue;
+                    if (Misc::StringUtils::lowerCase(std::string(actor.getClass().getName(actor)))
+                            .find(needle)
+                        == std::string::npos)
+                        continue;
+                    const float* ap = actor.getRefData().getPosition().pos;
+                    const float dx = ap[0] - pos.pos[0];
+                    const float dy = ap[1] - pos.pos[1];
+                    const float d = std::sqrt(dx * dx + dy * dy);
+                    if (best == nullptr || d < bestDist)
+                    {
+                        best = &actor;
+                        bestDist = d;
+                    }
+                }
+                if (best == nullptr)
+                    return {};
+                const float* ap = best->getRefData().getPosition().pos;
+                outDist = bestDist;
+                outBearing = bearingTo(ap, pos);
+                return *best;
+            }
+
+            std::string sanitize(std::string s, size_t limit)
+            {
+                std::replace(s.begin(), s.end(), '\n', ' ');
+                std::replace(s.begin(), s.end(), '\r', ' ');
+                if (s.size() > limit)
+                    s.resize(limit);
+                return s;
+            }
+
+            std::string demangleTypeName(const char* name)
+            {
+                int status = 0;
+                if (char* real = abi::__cxa_demangle(name, nullptr, nullptr, &status))
+                {
+                    std::string out(real);
+                    free(real);
+                    return out;
+                }
+                return name;
+            }
+
+            std::string menuDescription()
+            {
+                std::string out;
+                auto addWidget = [&out](MyGUI::Widget* w, const char* kind)
+                {
+                    if (w == nullptr)
+                        return;
+                    std::string caption;
+                    if (auto* text = w->castType<MyGUI::TextBox>(false))
+                        caption = text->getCaption();
+                    out += std::string(" ") + kind + "='" + sanitize(w->getName(), 40) + "'"
+                        + " cap='" + sanitize(caption, 40) + "'";
+                };
+                addWidget(MyGUI::InputManager::getInstance().getKeyFocusWidget(), "kfocus");
+                addWidget(MyGUI::InputManager::getInstance().getMouseFocusWidget(), "mfocus");
+                // The window the fork's gamepad dispatch routes controller
+                // events to (same accessor as [Android ControllerDispatch]);
+                // unlike MyGUI focus it is populated under gamepad nav.
+                if (auto* top = MWBase::Environment::get().getWindowManager()
+                        ->getActiveControllerWindow())
+                    out += " topWin='" + sanitize(demangleTypeName(typeid(*top).name()), 48) + "'"
+                        + " vis=" + (top->isVisible() ? "1" : "0");
+                return out;
+            }
+
+            void emitState(ControllerManager& cm)
+            {
+                (void)cm;
+                const MWWorld::Ptr player = playerPtr();
+                const ESM::Position& pos = player.getRefData().getPosition();
+                const MWBase::WindowManager* winMgr = MWBase::Environment::get().getWindowManager();
+
+                std::ostringstream out;
+                out << std::fixed << std::setprecision(1)
+                    << "pos=" << pos.pos[0] << ',' << pos.pos[1] << ',' << pos.pos[2]
+                    << std::setprecision(2)
+                    << " yaw=" << pos.rot[2] * 57.2957795f
+                    << " pitch=" << pos.rot[0] * 57.2957795f
+                    << " cell='" << player.getCell()->getCell()->getDescription() << "'"
+                    << " gui=" << (winMgr->isGuiMode() ? static_cast<int>(winMgr->getMode()) : -1);
+
+                const MWWorld::Ptr focus = MWBase::Environment::get().getWorld()->getFocusObject();
+                if (!focus.isEmpty())
+                {
+                    const float* fp = focus.getRefData().getPosition().pos;
+                    out << " faced='" << focus.getClass().getName(focus) << "'"
+                        << " fdist=" << std::sqrt(
+                               (fp[0] - pos.pos[0]) * (fp[0] - pos.pos[0])
+                               + (fp[1] - pos.pos[1]) * (fp[1] - pos.pos[1])
+                               + (fp[2] - pos.pos[2]) * (fp[2] - pos.pos[2]));
+                }
+                else
+                    out << " faced=none fdist=-1";
+
+                // Scene census: doors of the current cell, then nearby actors.
+                int doors = 0;
+                player.getCell()->forEachType<ESM::Door>([&](const MWWorld::Ptr& door)
+                {
+                    if (doors >= sMaxDoors)
+                        return false;
+                    const float* dp = door.getRefData().getPosition().pos;
+                    const float dx = dp[0] - pos.pos[0];
+                    const float dy = dp[1] - pos.pos[1];
+                    const float dz = dp[2] - pos.pos[2];
+                    const float dist = std::sqrt(dx * dx + dy * dy + dz * dz);
+                    if (dist > sCensusDoorRadius)
+                        return true;
+                    const std::string name(door.getClass().getName(door));
+                    if (name.empty())
+                        return true;
+                    const char* state = "";
+                    switch (door.getClass().getDoorState(door))
+                    {
+                        case MWWorld::DoorState::Opening: state = " opening"; break;
+                        case MWWorld::DoorState::Closing: state = " closing"; break;
+                        default: break;
+                    }
+                    out << " door:'" << name << "'"
+                        << std::setprecision(0)
+                        << "@b" << bearingTo(dp, pos) << ",d" << dist << state;
+                    ++doors;
+                    return true;
+                });
+
+                std::vector<MWWorld::Ptr> actors;
+                MWBase::Environment::get().getMechanicsManager()->getActorsInRange(
+                    osg::Vec3f(pos.pos[0], pos.pos[1], pos.pos[2]), sActorRadius, actors);
+                std::vector<std::pair<float, const MWWorld::Ptr*>> ranked;
+                for (const MWWorld::Ptr& actor : actors)
+                {
+                    if (actor == player || actor.isEmpty())
+                        continue;
+                    const float* ap = actor.getRefData().getPosition().pos;
+                    const float d = std::sqrt(
+                        (ap[0] - pos.pos[0]) * (ap[0] - pos.pos[0])
+                        + (ap[1] - pos.pos[1]) * (ap[1] - pos.pos[1]));
+                    ranked.emplace_back(d, &actor);
+                }
+                std::sort(ranked.begin(), ranked.end(),
+                    [](const auto& a, const auto& b) { return a.first < b.first; });
+                int listed = 0;
+                for (const auto& [dist, actor] : ranked)
+                {
+                    if (listed >= sMaxActors)
+                        break;
+                    const float* ap = actor->getRefData().getPosition().pos;
+                    out << " actor:'" << actor->getClass().getName(*actor) << "'"
+                        << std::setprecision(0)
+                        << "@b" << bearingTo(ap, pos) << ",d" << dist;
+                    ++listed;
+                }
+
+                // Hint target (same semantics as the 0011 telemetry).
+                std::string hint;
+                {
+                    std::lock_guard<std::mutex> lock(sMutex);
+                    hint = sHint;
+                }
+                if (!hint.empty())
+                {
+                    float dist = -1.f, bearing = 0.f;
+                    const MWWorld::Ptr target = nearestHintActor(hint, dist, bearing);
+                    if (!target.isEmpty())
+                        out << " target='" << target.getClass().getName(target) << "'"
+                            << std::setprecision(1)
+                            << " tbearing=" << bearing << " tdist=" << dist;
+                    else
+                        out << " target=none tdist=-1";
+                }
+
+                {
+                    std::lock_guard<std::mutex> lock(sActMutex);
+                    out << " act='" << sActResult << "'";
+                }
+
+                if (winMgr->isGuiMode())
+                    out << menuDescription();
+
+                if (sMode != Servo::Off)
+                    out << " servo=" << static_cast<int>(sMode);
+                else
+                    out << " servo=" << sServoReport;
+
+                Log(Debug::Info) << "[Android DebugState] " << out.str();
+            }
+        }
+
+        void noteActivate(const std::string& outcome)
+        {
+            std::lock_guard<std::mutex> lock(sActMutex);
+            sActResult = outcome;
+        }
+
+        bool idleCamDisabled()
+        {
+            static const bool disabled = []
+            {
+                const char* v = std::getenv("OPENMW_DEBUG_NO_IDLECAM");
+                return v != nullptr && v[0] != '0';
+            }();
+            return disabled;
+        }
+
+        void tick(float dt, ControllerManager& controllerManager)
+        {
+            (void)dt;
+
+            // --- debug target markers (OPENMW_DEBUG_MARKERS=1) ---
+            // Only touch the world while a game is actually running: tick
+            // also fires on the title screen / loading screens.
+            if (MWBase::Environment::get().getStateManager()->getState()
+                    == MWBase::StateManager::State_Running
+                && std::getenv("OPENMW_DEBUG_MARKERS") != nullptr
+                && std::getenv("OPENMW_DEBUG_MARKERS")[0] != '0')
+            {
+                static std::unique_ptr<MWRender::DebugMarkers> sMarkers;
+                if (!sMarkers)
+                {
+                    if (auto* rm = MWBase::Environment::get().getWorld()->getRenderingManager())
+                        sMarkers = std::make_unique<MWRender::DebugMarkers>(rm->getRootNode());
+                }
+                if (sMarkers)
+                    sMarkers->update();
+            }
+
+            // --- servo motors (synthetic axis events at frame rate) ---
+            const int epoch = sServoCancelEpoch.load(std::memory_order_relaxed);
+            if (sMode != Servo::Off && epoch != sCancelEpochSeen)
+            {
+                sCancelEpochSeen = epoch;
+                finishServo(controllerManager, "cancelled");
+            }
+            const int request = sServoRequest.exchange(0, std::memory_order_relaxed);
+            if (sMode == Servo::Off && request != 0)
+            {
+                sMode = static_cast<Servo>(request);
+                sServoStart = std::chrono::steady_clock::now();
+                sFaceResolved = false;
+                if (sMode == Servo::Turn)
+                    sTargetYaw = normalizeDeg(playerYawDeg() + sServoDeg.load(std::memory_order_relaxed));
+                if (sMode == Servo::Walk)
+                {
+                    sWalkLastCheck = sServoStart;
+                    sWalkLastPos = playerPos();
+                }
+            }
+
+            if (sMode == Servo::Turn || sMode == Servo::Face)
+            {
+                if (sMode == Servo::Face && !sFaceResolved)
+                {
+                    std::string hint;
+                    {
+                        std::lock_guard<std::mutex> lock(sMutex);
+                        hint = sFaceHint;
+                        sFaceHint.clear();
+                    }
+                    float dist = -1.f, bearing = 0.f;
+                    const MWWorld::Ptr target = nearestHintActor(hint, dist, bearing);
+                    if (target.isEmpty())
+                        finishServo(controllerManager, "done=no-target hint='" + hint + "'");
+                    else
+                    {
+                        sTargetYaw = normalizeDeg(playerYawDeg() + bearing);
+                        sFaceResolved = true;
+                    }
+                }
+                if (sMode == Servo::Turn || (sMode == Servo::Face && sFaceResolved))
+                {
+                    const float err = normalizeDeg(sTargetYaw - playerYawDeg());
+                    if (std::fabs(err) < sTurnDoneDeg)
+                    {
+                        finishServo(controllerManager, "done=aligned err="
+                            + std::to_string(err).substr(0, 4));
+                    }
+                    else
+                    {
+                        const float drive = std::clamp(err * sTurnGain, -1.f, 1.f);
+                        const float withFloor = std::copysign(
+                            std::max(sTurnFloor, std::fabs(drive)), drive);
+                        injectAxis(controllerManager, SDL_CONTROLLER_AXIS_RIGHTX, withFloor);
+                    }
+                }
+                if (sMode != Servo::Off)
+                {
+                    const float secs = std::chrono::duration<float>(
+                        std::chrono::steady_clock::now() - sServoStart).count();
+                    if (secs > sServoTimeout)
+                        finishServo(controllerManager, "done=timeout");
+                }
+            }
+            else if (sMode == Servo::Walk)
+            {
+                injectAxis(controllerManager, SDL_CONTROLLER_AXIS_LEFTY, -1.f);
+                const auto now = std::chrono::steady_clock::now();
+                const float held = std::chrono::duration<float>(now - sServoStart).count();
+                const int limitMs = sServoMs.load(std::memory_order_relaxed);
+                if (std::chrono::duration<float>(now - sWalkLastCheck).count() > 0.4f)
+                {
+                    const osg::Vec3f pos = playerPos();
+                    if ((pos - sWalkLastPos).length() < 2.f)
+                        finishServo(controllerManager, "done=blocked after="
+                            + std::to_string(held).substr(0, 4) + "s");
+                    else
+                    {
+                        sWalkLastCheck = now;
+                        sWalkLastPos = pos;
+                    }
+                }
+                if (sMode == Servo::Walk && limitMs > 0
+                    && held > static_cast<float>(limitMs) / 1000.f)
+                    finishServo(controllerManager, "done=distance");
+            }
+
+            // --- JOY_STATE hold ---
+            {
+                std::lock_guard<std::mutex> lock(sHoldMutex);
+                if (sHold.pending)
+                {
+                    for (int axis = 0; axis < 6; ++axis)
+                        injectAxis(controllerManager, axis, sHold.values[axis]);
+                    sHold.pending = false;
+                    sHold.active = sHold.end > std::chrono::steady_clock::now();
+                    if (!sHold.active)
+                        for (int axis = 0; axis < 6; ++axis)
+                            injectAxis(controllerManager, axis, 0.f);
+                }
+                else if (sHold.active && std::chrono::steady_clock::now() > sHold.end)
+                {
+                    for (int axis = 0; axis < 6; ++axis)
+                        injectAxis(controllerManager, axis, 0.f);
+                    sHold.active = false;
+                }
+            }
+
+            // --- one-shot save load (engine thread) ---
+            if (sLoadPending.exchange(false))
+            {
+                std::string path;
+                {
+                    std::lock_guard<std::mutex> lock(sMutex);
+                    path = sLoadPath;
+                    sLoadPath.clear();
+                }
+                if (!path.empty())
+                {
+                    Log(Debug::Info) << "[Android DebugLoad] loading " << path;
+                    try
+                    {
+                        MWBase::Environment::get().getStateManager()->loadGame(
+                            std::filesystem::path(path));
+                    }
+                    catch (const std::exception& e)
+                    {
+                        Log(Debug::Error) << "[Android DebugLoad] failed: " << e.what();
+                    }
+                }
+            }
+
+            // --- streaming telemetry / pending request ---
+            const int period = sStreamPeriod.load(std::memory_order_relaxed);
+            if (sStatePending.exchange(false))
+            {
+                sStreamCounter = 0;
+                emitState(controllerManager);
+            }
+            else if (period > 0 && ++sStreamCounter >= period)
+            {
+                sStreamCounter = 0;
+                emitState(controllerManager);
+            }
+        }
+
+#ifdef __ANDROID__
+        extern "C" JNIEXPORT void JNICALL
+            Java_debug_DebugInputReceiver_nativeDebugState2(JNIEnv* env, jclass, jstring hint)
+        {
+            const char* chars = hint ? env->GetStringUTFChars(hint, nullptr) : nullptr;
+            {
+                std::lock_guard<std::mutex> lock(sMutex);
+                sHint = chars ? chars : "";
+            }
+            if (chars)
+                env->ReleaseStringUTFChars(hint, chars);
+            sStatePending.store(true, std::memory_order_release);
+        }
+
+        extern "C" JNIEXPORT void JNICALL
+            Java_debug_DebugInputReceiver_nativeServo(JNIEnv* env, jclass, jint kind, jfloat deg,
+                jint ms, jstring hint)
+        {
+            const char* chars = hint ? env->GetStringUTFChars(hint, nullptr) : nullptr;
+            {
+                std::lock_guard<std::mutex> lock(sMutex);
+                sFaceHint = chars ? chars : "";
+            }
+            if (chars)
+                env->ReleaseStringUTFChars(hint, chars);
+            sServoDeg.store(deg, std::memory_order_relaxed);
+            sServoMs.store(ms, std::memory_order_relaxed);
+            sServoRequest.store(kind, std::memory_order_relaxed);
+        }
+
+        extern "C" JNIEXPORT void JNICALL
+            Java_debug_DebugInputReceiver_nativeServoCancel(JNIEnv*, jclass)
+        {
+            sServoCancelEpoch.fetch_add(1, std::memory_order_relaxed);
+        }
+
+        extern "C" JNIEXPORT void JNICALL
+            Java_debug_DebugInputReceiver_nativeStream(JNIEnv*, jclass, jint periodFrames)
+        {
+            sStreamPeriod.store(periodFrames, std::memory_order_relaxed);
+        }
+
+        extern "C" JNIEXPORT void JNICALL
+            Java_debug_DebugInputReceiver_nativeLoadSave(JNIEnv* env, jclass, jstring path)
+        {
+            const char* chars = path ? env->GetStringUTFChars(path, nullptr) : nullptr;
+            {
+                std::lock_guard<std::mutex> lock(sMutex);
+                sLoadPath = chars ? chars : "";
+            }
+            if (chars)
+                env->ReleaseStringUTFChars(path, chars);
+            sLoadPending.store(true, std::memory_order_release);
+        }
+
+        extern "C" JNIEXPORT void JNICALL
+            Java_debug_DebugInputReceiver_nativeJoyState(JNIEnv*, jclass, jfloat x0, jfloat y0,
+                jfloat x1, jfloat y1, jfloat lt, jfloat rt, jint durationMs)
+        {
+            std::lock_guard<std::mutex> lock(sHoldMutex);
+            sHold.values[0] = x0;
+            sHold.values[1] = y0;
+            sHold.values[2] = x1;
+            sHold.values[3] = y1;
+            sHold.values[4] = lt;
+            sHold.values[5] = rt;
+            sHold.pending = true;
+            sHold.active = durationMs > 0;
+            sHold.end = std::chrono::steady_clock::now()
+                + std::chrono::milliseconds(std::max(0, static_cast<int>(durationMs)));
+        }
+#endif
+    }
+}
